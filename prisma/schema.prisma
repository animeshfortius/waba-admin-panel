generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  RESELLER
  USER
}

model User {
  id             String    @id @default(uuid())
  name           String
  username       String?   @unique
  email          String    @unique
  password       String
  phone          String?
  expiryDate     String?
  role           Role      @default(USER)

  walletBalance  Float     @default(0.0)
  actualBalance  Float     @default(0.0)
  virtualBalance Float     @default(0.0)

  // WhatsApp Category Rates
  perMsgRate     Float     @default(0.8046) // Marketing Rate
  utilityRate    Float     @default(0.1550) // Utility Rate
  serviceRate    Float     @default(0.1550) // Service Rate
  authRate       Float     @default(0.1550) // Authentication Rate

  createdById    String?
  createdBy      User?     @relation("UserHierarchy", fields: [createdById], references: [id])
  childUsers     User[]    @relation("UserHierarchy")

  transactions   WalletTransaction[]
  wabaAccounts   WabaAccount[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amount      Float
  type        String
  description String
  createdAt   DateTime @default(now())
}

model WabaAccount {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  wabaId        String   @unique
  phoneNumberId String
  displayPhone  String
  accessToken   String
  status        String   @default("ACTIVE")
  createdAt     DateTime @default(now())
}