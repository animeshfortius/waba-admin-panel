generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  name                 String
  username             String?             @unique
  email                String              @unique
  password             String
  phone                String?
  expiryDate           String?
  apiKey               String?
  role                 Role                @default(USER)
  walletBalance        Float               @default(0.0)
  actualBalance        Float               @default(0.0)
  virtualBalance       Float               @default(0.0)
  perMsgRate           Float               @default(0.8046)
  utilityRate          Float               @default(0.1550)
  serviceRate          Float               @default(0.1550)
  authRate             Float               @default(0.1550)
  
  // 👇 WhatsApp Account Settings Toggles
  whatsappApiEnabled   Boolean             @default(true)
  chatbotEnabled       Boolean             @default(true)
  secureReporting      Boolean             @default(false)
  internationalAccount Boolean             @default(false)

  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            User?               @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: Cascade)
  childUsers           User[]              @relation("UserHierarchy")
  wabaAccounts         WabaAccount[]
  transactions         WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  type        String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WabaAccount {
  id             String   @id @default(uuid())
  userId         String
  wabaId         String   @unique
  phoneNumberId  String
  displayPhone   String
  displayName    String?  @default("100 App")
  accessToken    String
  status         String   @default("ACTIVE")
  qualityRating  String?  @default("UNKNOWN")
  messagingLimit String?  @default("TIER_NOT_FOUND")
  isDefault      Boolean  @default(false)
  webhookUrl     String?  @default("NA")
  description    String?
  address        String?
  email          String?
  website        String?
  category       String?  @default("Other")
  profilePicture String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaLibrary {
  id         String   @id @default(uuid())
  userId     String
  mediaName  String
  url        String
  wabaNumber String   @default("All")
  fileType   String?  @default("image") // image, video, document
  expiresAt  DateTime // Used for 30-day automatic cleanup
  createdAt  DateTime @default(now())
}

model WhatsAppContact {
  id          String   @id @default(uuid())
  userId      String
  number      String
  profileName String?
  email       String?
  contactName String?
  createdAt   DateTime @default(now())
}

model ContactGroup {
  id            String   @id @default(uuid())
  userId        String
  groupName     String
  totalContacts Int      @default(0)
  createdAt     DateTime @default(now())
}

model BlacklistNumber {
  id        String   @id @default(uuid())
  userId    String
  number    String
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  RESELLER
  USER
}

model WhatsAppTemplate {
  id             String   @id @default(uuid())
  userId         String
  wabaId         String
  wabaNumber     String
  metaTemplateId String?  @unique
  name           String
  language       String   @default("en_US")
  category       String   // UTILITY, MARKETING, AUTHENTICATION
  status         String   @default("PENDING") // APPROVED, PENDING, REJECTED, PAUSED
  headerType     String?  @default("NONE") // NONE, TEXT, IMAGE, VIDEO, DOCUMENT
  headerText     String?
  bodyText       String
  footerText     String?
  buttons        Json?
  components     Json?    // Raw Meta components payload
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
model CampaignLog {
  id           String    @id @default(uuid())
  userId       String
  campaignName String
  templateName String
  channel      String    // WABA Number / Display Phone
  recipient    String    // Target Mobile Number
  status       String    // SENT, DELIVERED, READ, FAILED
  messageId    String?   @unique // 👈 Made unique for direct webhook matching
  cost         Float     @default(0.0)
  errorDetails String?   @default("N/A")
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime  @default(now())
}