generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String             @id @default(uuid())
  name                 String
  username             String?            @unique
  email                String             @unique
  password             String
  phone                String?
  image                String?            @db.Text // 👈 Profile picture/avatar save karne ke liye nayi field
  expiryDate           String?
  apiKey               String?            @unique
  role                 Role               @default(USER)
  walletBalance        Float              @default(0.0)
  actualBalance        Float              @default(0.0)
  virtualBalance       Float              @default(0.0)
  perMsgRate           Float              @default(0.8046)
  utilityRate          Float              @default(0.1550)
  serviceRate          Float              @default(0.1550)
  authRate             Float              @default(0.1550)
  
  // 👇 WhatsApp Account Settings Toggles
  whatsappApiEnabled   Boolean            @default(true)
  chatbotEnabled       Boolean            @default(true)
  secureReporting      Boolean            @default(false)
  internationalAccount Boolean            @default(false)

  createdById          String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  createdBy            User?              @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: Cascade)
  childUsers           User[]             @relation("UserHierarchy")
  wabaAccounts         WabaAccount[]
  transactions         WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  type        String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WabaAccount {
  id             String   @id @default(cuid())
  userId         String
  wabaId         String   @unique
  phoneNumberId  String
  displayPhone   String
  displayName    String?  @default("100 App")
  accessToken    String
  status         String   @default("ACTIVE")
  qualityRating  String?  @default("UNKNOWN")
  messagingLimit String?  @default("TIER_NOT_FOUND")
  isDefault      Boolean  @default(false)
  webhookUrl     String?  @default("NA")
  description    String?
  address        String?
  email          String?
  website        String?
  category       String?  @default("Other")
  profilePicture String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaLibrary {
  id          String   @id @default(uuid())
  userId      String
  mediaName   String
  url         String
  wabaNumber  String   @default("All")
  fileType    String?  @default("image")
  expiresAt   DateTime 
  createdAt   DateTime @default(now())
}

model WhatsAppContact {
  id          String   @id @default(uuid())
  userId      String
  number      String
  profileName String?
  email       String?
  contactName String?
  createdAt   DateTime @default(now())
}

model ContactGroup {
  id            String   @id @default(uuid())
  userId        String
  groupName     String
  totalContacts Int      @default(0)
  createdAt     DateTime @default(now())
}

model BlacklistNumber {
  id        String   @id @default(uuid())
  userId    String
  number    String
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  RESELLER
  USER
}

model WhatsAppTemplate {
  id             String   @id @default(uuid())
  userId         String
  wabaId         String
  wabaNumber     String
  metaTemplateId String?  @unique
  name           String
  language       String   @default("en_US")
  category       String   
  status         String   @default("PENDING") 
  headerType     String?  @default("NONE") 
  headerText     String?
  bodyText       String
  footerText     String?
  buttons        Json?
  components     Json?    
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CampaignLog {
  id           String    @id @default(uuid())
  userId       String
  campaignName String
  templateName String
  channel      String    
  recipient    String    
  status       String    
  messageId    String?   
  cost         Float     @default(0.0)
  errorDetails String?   @default("N/A")
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([messageId])
  @@index([recipient])
}

model ChatSession {
  id            String        @id @default(uuid())
  userId        String        
  customerPhone String        
  customerName  String?       
  channel       String        
  status        String        @default("OPEN") 
  assignedTo    String?       
  isBotActive   Boolean       @default(true) 
  lastMessage   String?       
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
  notes         ChatNote[]    
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  senderType    String      
  senderName    String?     
  messageBody   String      
  messageType   String      @default("text") 
  mediaUrl      String?     
  status        String      @default("SENT") 
  wabaMessageId String?     
  createdAt     DateTime    @default(now())
}

model ChatNote {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  agentName     String      
  noteBody      String      
  createdAt     DateTime    @default(now())
}

model Agent {
  id               String    @id @default(cuid())
  userId           String    @unique
  name             String
  email            String    @unique
  phone            String
  password         String
  expiryDate       DateTime?
  allChannelAccess Boolean   @default(true)
  assignedChannels String?   @default("[]")
  chatConfig       String?   @default("{}")
  sendTemplate     Boolean   @default(false)
  sendCampaign     Boolean   @default(false)
  liveChat         Boolean   @default(true)
  role             String    @default("AGENT")
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
}