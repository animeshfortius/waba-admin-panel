generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String              @id @default(uuid())
  name                 String
  username             String?             @unique
  email                String              @unique
  password             String
  phone                String?
  expiryDate           String?
  apiKey               String?
  role                 Role                @default(USER)
  walletBalance        Float               @default(0.0)
  actualBalance        Float               @default(0.0)
  virtualBalance       Float               @default(0.0)
  perMsgRate           Float               @default(0.8046)
  utilityRate          Float               @default(0.1550)
  serviceRate          Float               @default(0.1550)
  authRate             Float               @default(0.1550)
  
  // 👇 WhatsApp Account Settings Toggles
  whatsappApiEnabled   Boolean             @default(true)
  chatbotEnabled       Boolean             @default(true)
  secureReporting      Boolean             @default(false)
  internationalAccount Boolean             @default(false)

  createdById          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  createdBy            User?               @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: Cascade)
  childUsers           User[]              @relation("UserHierarchy")
  wabaAccounts         WabaAccount[]
  transactions         WalletTransaction[]
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  type        String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WabaAccount {
  id             String   @id @default(uuid())
  userId         String
  wabaId         String   @unique
  phoneNumberId  String
  displayPhone   String
  displayName    String?  @default("100 App")
  accessToken    String
  status         String   @default("ACTIVE")
  qualityRating  String?  @default("UNKNOWN")
  messagingLimit String?  @default("TIER_NOT_FOUND")
  isDefault      Boolean  @default(false)
  webhookUrl     String?  @default("NA")
  description    String?
  address        String?
  email          String?
  website        String?
  category       String?  @default("Other")
  profilePicture String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaAsset {
  id         String   @id @default(uuid())
  userId     String
  mediaName  String
  mediaUrl   String
  wabaNumber String
  createdAt  DateTime @default(now())
}

model WhatsAppContact {
  id          String   @id @default(uuid())
  userId      String
  number      String
  profileName String?
  email       String?
  contactName String?
  createdAt   DateTime @default(now())
}

model ContactGroup {
  id            String   @id @default(uuid())
  userId        String
  groupName     String
  totalContacts Int      @default(0)
  createdAt     DateTime @default(now())
}

model BlacklistNumber {
  id        String   @id @default(uuid())
  userId    String
  number    String
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  RESELLER
  USER
}