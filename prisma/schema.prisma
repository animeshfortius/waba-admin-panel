generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String  @id @default(uuid())
  name           String
  username       String? @unique
  email          String  @unique
  password       String
  phone          String?
  image          String? @db.Text
  expiryDate     String?
  apiKey         String? @unique
  role           Role    @default(USER)
  isWhiteLabel   Boolean @default(false)
  walletBalance  Float   @default(0.0)
  actualBalance  Float   @default(0.0)
  virtualBalance Float   @default(0.0)
  perMsgRate     Float   @default(0.8046)
  utilityRate    Float   @default(0.1550)
  serviceRate    Float   @default(0.1550)
  authRate       Float   @default(0.1550)

  // WhatsApp Account Settings Toggles
  whatsappApiEnabled   Boolean @default(true)
  chatbotEnabled       Boolean @default(true)
  secureReporting      Boolean @default(false)
  internationalAccount Boolean @default(false)

  createdById      String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  createdBy        User?               @relation("UserHierarchy", fields: [createdById], references: [id], onDelete: Cascade)
  childUsers       User[]              @relation("UserHierarchy")
  wabaAccounts     WabaAccount[]
  transactions     WalletTransaction[]
  whiteLabelConfig WhiteLabelConfig?
}

model WhiteLabelConfig {
  id           String   @id @default(cuid())
  userId       String   @unique
  domain       String   @unique
  brandName    String
  logoUrl      String?  @db.Text
  faviconUrl   String?  @db.Text
  primaryColor String   @default("#059669")
  supportEmail String?
  supportPhone String?
  serverIp     String?  @default("171.50.181.171")
  sslStatus    String   @default("PENDING")
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WalletTransaction {
  id          String   @id @default(uuid())
  userId      String
  amount      Float
  type        String
  description String
  balanceType String?
  referenceId String?
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model WabaAccount {
  id             String   @id @default(cuid())
  userId         String
  wabaId         String   @unique
  phoneNumberId  String
  displayPhone   String
  displayName    String?  @default("100 App")
  accessToken    String
  status         String   @default("ACTIVE")
  qualityRating  String?  @default("UNKNOWN")
  messagingLimit String?  @default("TIER_NOT_FOUND")
  isDefault      Boolean  @default(false)
  webhookUrl     String?  @default("NA")
  description    String?
  address        String?
  email          String?
  website        String?
  category       String?  @default("Other")
  profilePicture String?
  createdAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model MediaLibrary {
  id         String   @id @default(uuid())
  userId     String
  mediaName  String
  url        String
  wabaNumber String   @default("All")
  fileType   String?  @default("image")
  expiresAt  DateTime
  createdAt  DateTime @default(now())
}

model WhatsAppContact {
  id          String   @id @default(uuid())
  userId      String
  number      String
  profileName String?
  email       String?
  contactName String?
  createdAt   DateTime @default(now())
}

model ContactGroup {
  id            String         @id @default(uuid())
  userId        String
  groupName     String
  totalContacts Int            @default(0)
  createdAt     DateTime       @default(now())
  contacts      GroupContact[]
}

model BlacklistNumber {
  id        String   @id @default(uuid())
  userId    String
  number    String
  createdAt DateTime @default(now())
}

enum Role {
  SUPER_ADMIN
  WHITE_LABEL_RESELLER
  RESELLER
  USER
}

model WhatsAppTemplate {
  id             String   @id @default(uuid())
  userId         String
  wabaId         String
  wabaNumber     String
  metaTemplateId String?  @unique
  name           String
  language       String   @default("en_US")
  category       String
  status         String   @default("PENDING")
  headerType     String?  @default("NONE")
  headerText     String?
  bodyText       String
  footerText     String?
  buttons        Json?
  components     Json?
  rejectedReason String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CampaignLog {
  id           String    @id @default(uuid())
  userId       String
  campaignName String
  templateName String
  channel      String
  recipient    String
  status       String
  messageId    String?
  cost         Float     @default(0.0)
  errorDetails String?   @default("N/A")
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  readAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([messageId])
  @@index([recipient])
}

model ChatSession {
  id            String        @id @default(uuid())
  userId        String
  customerPhone String
  customerName  String?
  channel       String
  status        String        @default("OPEN")
  assignedTo    String?
  isBotActive   Boolean       @default(true)
  lastMessage   String?
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  messages      ChatMessage[]
  notes         ChatNote[]
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  senderType    String
  senderName    String?
  messageBody   String
  messageType   String      @default("text")
  mediaUrl      String?
  status        String      @default("SENT")
  wabaMessageId String?
  createdAt     DateTime    @default(now())
}

model ChatNote {
  id            String      @id @default(uuid())
  chatSessionId String
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)
  agentName     String
  noteBody      String
  createdAt     DateTime    @default(now())
}

model Agent {
  id               String    @id @default(cuid())
  userId           String    @unique
  name             String
  email            String    @unique
  phone            String
  password         String
  expiryDate       DateTime?
  allChannelAccess Boolean   @default(true)
  assignedChannels String?   @default("[]")
  chatConfig       String?   @default("{}")
  sendTemplate     Boolean   @default(false)
  sendCampaign     Boolean   @default(false)
  liveChat         Boolean   @default(true)
  role             String    @default("AGENT")
  status           String    @default("ACTIVE")
  createdAt        DateTime  @default(now())
}

model GroupContact {
  id        String       @id @default(uuid())
  groupId   String
  number    String
  name      String?      @default("Member")
  createdAt DateTime     @default(now())
  group     ContactGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId])
}

// Automation Tools Models (Visual Flow Builder, AI Chatbot, WhatsApp Flows, QR Codes)
model ChatbotConfig {
  id             String        @id @default(cuid())
  userId         String        @default("admin")
  wabaAccountId  String?
  phoneNumberId  String?
  channelNumber  String?
  name           String
  mode           String        @default("CHAT_FLOW")
  triggerType    String        @default("KEYWORD")
  keywords       String?
  isActive       Boolean       @default(true)
  isPublished    Boolean       @default(false)
  aiProvider     String        @default("OPENAI")
  aiModel        String        @default("gpt-4o-mini")
  aiApiKey       String?
  aiSystemPrompt String?       @db.Text
  fallbackText   String?       @db.Text
  canvasJson     String?       @db.Text
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  nodes          ChatbotNode[]
}

model ChatbotNode {
  id          String        @id @default(cuid())
  chatbotId   String
  chatbot     ChatbotConfig @relation(fields: [chatbotId], references: [id], onDelete: Cascade)
  nodeKey     String
  title       String
  messageType String        @default("SEND_MESSAGE")
  bodyText    String        @db.Text
  headerText  String?
  footerText  String?
  optionsJson String?       @db.Text
  flowId      String?
  posX        Float         @default(320)
  posY        Float         @default(120)
  parentKey   String?
  sortOrder   Int           @default(0)
  createdAt   DateTime      @default(now())
}

model WhatsAppFlowRecord {
  id            String   @id @default(cuid())
  userId        String   @default("admin")
  wabaId        String
  phoneNumberId String?
  metaFlowId    String?  @unique
  name          String
  categories    String   @default("[\"OTHER\"]")
  status        String   @default("DRAFT")
  endpointUri   String?
  flowJson      String?  @db.Text
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model WhatsAppQrCode {
  id            String   @id @default(cuid())
  userId        String   @default("admin")
  phoneNumberId String
  code          String?  @unique
  prefilledText String   @db.Text
  generateQrImg String   @default("PNG")
  qrImageUrl    String?  @db.Text
  deepLinkUrl   String?
  syncedAt      DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model AutomationSessionState {
  id             String   @id @default(cuid())
  phoneNumberId  String
  customerPhone  String
  chatbotId      String?
  currentNodeKey String?
  contextJson    String?  @db.Text
  updatedAt      DateTime @updatedAt

  @@unique([phoneNumberId, customerPhone])
}